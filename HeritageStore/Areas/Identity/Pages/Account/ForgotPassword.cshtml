@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "استعادة كلمة المرور";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-card">

        <h2>نسيت كلمة المرور؟</h2>
        <hr class="auth-divider-top" />
        <p class="auth-subtitle">أدخل بريدك الإلكتروني وسنرسل لك رابطًا لإعادة تعيين كلمة المرور</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="البريد الإلكتروني" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger"></span>

            <button type="submit" class="btn-auth-primary mt-3">إرسال رابط الاستعادة</button>

            <div class="auth-or-divider"><span>أو</span></div>

            <a asp-page="./Login" class="btn-auth-outline">
                <i class="bi bi-box-arrow-in-left"></i> العودة لتسجيل الدخول
            </a>
        </form>

        <p class="auth-footer-note">
            بمتابعتك، أنت توافق على <a href="#">الشروط والأحكام</a> و<a href="#">سياسة الخصوصية</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}