@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "استعادة كلمة المرور";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">

    <!-- نقاط التزيين الفاتحة -->
    <div class="auth-dots-decor">
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
    </div>

    <!-- الحاوية المزدوجة الفاتحة -->
    <div class="auth-container">

        <!-- جانب اللوغو -->
        <div class="auth-side-image">
            <img src="~/images/logoHeritage.png" alt="لوغو حِكاية" class="auth-brand-logo" />
        </div>

        <!-- جانب النموذج الفاتح -->
        <div class="auth-side-form">

            <h2>نسيت كلمة المرور؟</h2>

            <p class="auth-subtitle">
                أدخل بريدك الإلكتروني وسنرسل لك رابطًا لإعادة تعيين كلمة المرور
            </p>

            <form method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <!-- Email Input -->
                <div class="form-group-wrapper">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="البريد الإلكتروني" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-auth-primary mt-2">
                    إرسال رابط الاستعادة
                </button>

                <!-- Divider -->
                <div class="auth-or-divider">
                    <span>أو</span>
                </div>

                <!-- Back to Login Button -->
                <a asp-page="./Login" class="btn-auth-outline">
                    <i class="bi bi-box-arrow-in-left"></i>
                    العودة لتسجيل الدخول
                </a>

            </form>

            <p class="auth-footer-note">
                بمتابعتك، أنت توافق على
                <a href="#">الشروط والأحكام</a>
                و
                <a href="#">سياسة الخصوصية</a>
            </p>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}