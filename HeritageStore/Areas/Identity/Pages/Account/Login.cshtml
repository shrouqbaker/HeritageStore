@page
@model LoginModel

@{
    ViewData["Title"] = "تسجيل الدخول";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">

    <!-- نقاط التزيين الفاتحة -->
    <div class="auth-dots-decor">
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
    </div>

    <!-- الحاوية المزدوجة الفاتحة -->
    <div class="auth-container">

        <!-- جانب اللوغو -->
        <div class="auth-side-image">
            <img src="~/images/logoHeritage.png" alt="لوغو حِكاية" class="auth-brand-logo" />
        </div>

        <!-- جانب النموذج الفاتح -->
        <div class="auth-side-form">

            <h2>تسجيل الدخول</h2>

            <p class="auth-subtitle">
                مرحبًا بك مجددًا! يرجى تسجيل الدخول لمتابعة رحلتك
            </p>

            <form id="account" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <input type="hidden" id="loginGuestCartInput" asp-for="GuestCartJson" />
                <input type="hidden" id="loginGuestFavsInput" asp-for="GuestFavsJson" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <!-- Email or Username -->
                <div class="form-group-wrapper">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-person"></i>
                        </span>
                        <input asp-for="Input.Email"
                               type="text"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="اسم المستخدم أو البريد الإلكتروني" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="form-group-wrapper">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="Input.Password"
                               class="form-control"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="كلمة المرور" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="auth-options">
                    <div class="form-check d-flex align-items-center gap-2">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label asp-for="Input.RememberMe" class="form-check-label">تذكرني</label>
                    </div>
                    <a id="forgot-password" asp-page="./ForgotPassword">نسيت كلمة المرور؟</a>
                </div>

                <!-- Login Button -->
                <button id="login-submit" type="submit" class="btn-auth-primary">
                    تسجيل الدخول
                </button>

                <!-- Divider -->
                <div class="auth-or-divider">
                    <span>أو</span>
                </div>

                <!-- Register Button -->
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn-auth-outline">
                    <i class="bi bi-person-plus"></i>
                    إنشاء حساب جديد
                </a>

            </form>

            <p class="auth-footer-note">
                بمتابعة دخولك، أنت توافق على
                <a href="#">الشروط والأحكام</a>
                و
                <a href="#">سياسة الخصوصية</a>
            </p>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            try {
                const cart = localStorage.getItem('guestCart');
                const favs = localStorage.getItem('guestFavorites');
                const cartInput = document.getElementById('loginGuestCartInput');
                const favsInput = document.getElementById('loginGuestFavsInput');
                if (cartInput && cart) cartInput.value = cart;
                if (favsInput && favs) favsInput.value = favs;

                const form = document.getElementById('account');
                if (form) {
                    form.addEventListener('submit', function () {
                        const currentCart = localStorage.getItem('guestCart');
                        const currentFavs = localStorage.getItem('guestFavorites');
                        if (cartInput && currentCart) cartInput.value = currentCart;
                        if (favsInput && currentFavs) favsInput.value = currentFavs;
                    });
                }
            } catch (e) {
                console.error('Error attaching guest data to login form:', e);
            }
        });
    </script>
}