@model HeritageStore.Models.ViewModels.ProfileEditViewModel
@{
    ViewData["Title"] = "صفحتي الشخصية";
    var approvedProducts = Model.Products.Where(p => p.Status == "approved" || p.Status == "sold" || p.Status == "archived").ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/explore.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="container profile-page py-4 py-lg-5" dir="rtl">

    @* Breadcrumb *@
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb profile-breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door-fill me-1"></i> الرئيسية</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">صفحتي الشخصية</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @* القائمة الجانبية (Sidebar) *@
        <div class="col-lg-4 col-xl-3">
            <div class="modern-profile-sidebar">
                @* صندوق الصورة مع زر القلم الصغير لحفظ وتغيير الصورة فورياً *@
                <div class="profile-avatar-box">
                    @if (!string.IsNullOrEmpty(Model.ProfileImage))
                    {
                        <img src="@Model.ProfileImage" alt="@Model.UserName" class="profile-avatar-img" id="avatarPreview" />
                    }
                    else
                    {
                        <div class="profile-avatar-img d-flex align-items-center justify-content-center" id="avatarPlaceholderBox">
                            <i class="bi bi-person fs-1" style="color: var(--gold);" id="avatarPlaceholder"></i>
                        </div>
                        <img src="" alt="" class="profile-avatar-img d-none" id="avatarPreview" />
                    }

                    <label for="instantAvatarInput" class="profile-avatar-badge" title="تغيير وحفظ الصورة فورياً">
                        <i class="bi bi-pencil-fill" style="font-size: 0.82rem;"></i>
                    </label>
                    <input type="file" id="instantAvatarInput" class="d-none" accept="image/*" />
                </div>

                <h3 class="profile-user-name" id="sidebarUserName">@Model.UserName</h3>

                @* قائمة التبويبات للتنقل داخل نفس الصفحة بدون فتح صفحة جديدة *@
                <div class="profile-nav-list" role="tablist">
                    <button type="button" class="profile-nav-btn active" data-tab-target="tab-personal">
                        <i class="bi bi-person-fill"></i>
                        <span>المعلومات الشخصية</span>
                    </button>

                    <button type="button" class="profile-nav-btn" data-tab-target="tab-products">
                        <i class="bi bi-box-seam"></i>
                        <span>منتجاتي</span>
                        <span class="nav-badge" id="sidebarProductsBadge">@Model.TotalProducts</span>
                    </button>

                    <button type="button" class="profile-nav-btn" data-tab-target="tab-orders">
                        <i class="bi bi-bag-check"></i>
                        <span>طلباتي</span>
                        <span class="nav-badge">@Model.TotalOrders</span>
                    </button>

                    <button type="button" class="profile-nav-btn" data-tab-target="tab-preview">
                        <i class="bi bi-eye"></i>
                        <span>معاينة ملفي العام</span>
                    </button>

                    <button type="submit" form="logoutForm" class="profile-nav-btn" style="color:var(--maroon)">
                        <i class="bi bi-box-arrow-right" style="color:var(--maroon)"></i>
                        <span>تسجيل الخروج</span>
                    </button>
                </div>
            </div>
        </div>

        @* المساحة الرئيسية (المحتوى يتغير حسب التبويب دون الانتقال لصفحة جديدة) *@
        <div class="col-lg-8 col-xl-9">

            @* ==================== TAB 1: المعلومات الشخصية ==================== *@
            <div id="tab-personal" class="profile-tab-pane active">
                <div class="modern-profile-card">
                    <div class="profile-card-header">
                        <h2>المعلومات الشخصية</h2>

                        @* زر التعديل *@
                        <button type="button" id="btnToggleEdit" class="btn-edit-profile-pill">
                            <i class="bi bi-pencil-square" id="editBtnIcon"></i>
                            <span id="editBtnText">تعديل البيانات</span>
                        </button>
                    </div>

                    <form asp-controller="Profile" asp-action="Index" method="post" id="personalInfoForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-4">
                            @* اسم المستخدم (قابل للتعديل عند الضغط على زر التعديل) *@
                            <div class="col-md-6">
                                <label asp-for="UserName" class="profile-field-label">اسم المستخدم</label>
                                <div class="profile-input-wrapper">
                                    <input asp-for="UserName" id="inputUserName" class="profile-form-control is-readonly" readonly />
                                </div>
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            @* حالة الحساب *@
                            <div class="col-md-6">
                                <label class="profile-field-label">البريد الإلكتروني</label>
                                <div class="profile-input-wrapper">
                                    <input type="email" class="profile-form-control is-readonly" value="@Model.Email" readonly style="direction:rtl" />
                                   
                                </div>
                            </div>

                      
                            @* رقم الهاتف (قابل للتعديل) *@
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="profile-field-label">رقم الهاتف</label>
                                <div class="profile-input-wrapper">
                                    <input asp-for="PhoneNumber" id="inputPhoneNumber" class="profile-form-control is-readonly" placeholder="لم يُحدد رقم هاتف بعد"  readonly />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            @* تاريخ الانضمام *@
                            <div class="col-md-6">
                                <label class="profile-field-label">تاريخ الانضمام</label>
                                <div class="profile-input-wrapper">
                                    <input type="text" class="profile-form-control is-readonly" value="@Model.CreatedAt.ToString("dd/MM/yyyy")" readonly style="padding-left: 2.5rem;" />
                                    <i class="bi bi-calendar3 input-icon-pill"></i>
                                </div>
                            </div>

                            @* النبذة التعريفية (قابلة للتعديل) *@
                            <div class="col-12">
                                <label asp-for="Bio" class="profile-field-label">نبذة عن المستخدم</label>
                                <div class="profile-input-wrapper">
                                    <textarea asp-for="Bio" id="inputBio" class="profile-form-control is-readonly" rows="4" placeholder="اكتب نبذة عن اهتمامك بالتراث أو أعمالك..." readonly></textarea>
                                </div>
                                <span asp-validation-for="Bio" class="text-danger small"></span>
                            </div>
                        </div>

                        @* أزرار الحفظ والإلغاء تظهر فقط عند التعديل *@
                        <div id="editActionButtons" class="d-none mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-heritage px-4 py-2 me-2">
                                <i class="bi bi-check-lg me-1"></i> حفظ التعديلات
                            </button>
                            <button type="button" id="btnCancelEdit" class="btn btn-outline-secondary px-4 py-2">
                                إلغاء
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            @* ==================== TAB 2: منتجاتي ==================== *@
            <div id="tab-products" class="profile-tab-pane">
                <div class="modern-profile-card">
                    <div class="profile-card-header">
                        <h2 id="productsCountHeader">منتجاتك التراثية (@Model.TotalProducts)</h2>
                        <a asp-controller="Product" asp-action="Add" class="btn btn-heritage btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> أضف قطعة جديدة
                        </a>
                    </div>

                    <div class="row g-3 @(Model.Products.Any() ? "" : "d-none")" id="userProductsList">
                        @foreach (var p in Model.Products)
                        {
                            var mainImg = p.ProductImages.FirstOrDefault(i => i.IsMain)?.ImageUrl
                                          ?? p.ProductImages.FirstOrDefault()?.ImageUrl
                                          ?? "/images/placeholder.jpg";

                            string statusClass = "status-pending";
                            string statusText = "قيد المراجعة";

                            switch (p.Status)
                            {
                                case "approved":
                                    statusClass = "status-approved";
                                    statusText = "معتمد ومنشور";
                                    break;
                                case "sold":
                                    statusClass = "status-sold";
                                    statusText = "تم بيع القطعة";
                                    break;
                                case "rejected":
                                    statusClass = "status-rejected";
                                    statusText = "مرفوض";
                                    break;
                                case "archived":
                                    statusClass = "status-archived";
                                    statusText = "في الأرشيف";
                                    break;
                            }

                            <div class="col-md-6" id="productCard_@p.ProductId">
                                <div class="heritage-card h-100 p-3 d-flex flex-column">
                                    <div class="d-flex gap-3 mb-2">
                                        <img src="@mainImg" alt="@p.Name" style="width: 80px; height: 80px; border-radius: 10px; object-fit: cover; border: 1px solid var(--border);" />
                                        <div class="flex-grow-1 min-w-0">
                                            <span class="status-pill @statusClass mb-1">@statusText</span>
                                            <h6 class="mb-1 text-truncate" title="@p.Name">@p.Name</h6>
                                            <small class="text-muted d-block">
                                                @(p.Category?.Name ?? "") @(p.EmbroideryType != null ? "• تطريز " + p.EmbroideryType.Name : "")
                                            </small>
                                            @if (p.Price.HasValue && p.ListingType == "for_sale")
                                            {
                                                <strong style="color: var(--maroon);">@p.Price.Value.ToString("N0") د.أ</strong>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border">للعرض فقط</span>
                                            }
                                        </div>
                                    </div>

                                    @if (p.Status == "rejected" && !string.IsNullOrWhiteSpace(p.RejectionReason))
                                    {
                                        <div class="rejection-notice small mt-2">
                                            <strong>سبب الرفض:</strong> @p.RejectionReason
                                        </div>
                                    }

                                    
                                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                        <small class="text-muted">@p.CreatedAt.ToString("dd/MM/yyyy")</small>
                                        <div class="d-flex align-items-center gap-2">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@p.ProductId" class="btn btn-outline-heritage btn-sm py-1 px-3 view">
                                                <i class="bi bi-eye"></i> عرض
                                            </a>
                                            @if (p.Status != "sold"){
                                            <button type="button" class="btn btn-outline-heritage btn-sm py-1 px-2 btn-delete-product"
                                                    data-product-id="@p.ProductId"
                                                    data-product-name="@p.Name"
                                                    title="حذف القطعة التراثية">
                                                <i class="bi bi-trash3"></i> حذف
                                            </button>
                                            }
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>
                        }
                    </div>

                    <div class="heritage-empty-card py-5 @(Model.Products.Any() ? "d-none" : "")" id="userProductsEmptyState">
                        <div class="heritage-empty-icon">
                            <i class="bi bi-box2"></i>
                        </div>
                        <h4>لم تقم بإضافة أي قطعة بعد</h4>
                        <p class="text-muted">شارك حكاية وتفاصيل أثوابك وتطريزاتك التراثية معنا للمحافظة على الهوية.</p>
                        <a asp-controller="Product" asp-action="Add" class="btn btn-heritage">
                            <i class="bi bi-plus-circle me-1"></i> أضف قطعتك الأولى الآن
                        </a>
                    </div>
                </div>
            </div>

            @* ==================== TAB 3: طلباتي ==================== *@
            <div id="tab-orders" class="profile-tab-pane">
                <div class="modern-profile-card">
                    <div class="profile-card-header">
                        <h2>سجل طلباتي (@Model.TotalOrders)</h2>
                        <a asp-controller="Explore" asp-action="Index" class="btn btn-outline-heritage btn-sm">
                            <i class="bi bi-compass me-1"></i> استكشف التراث
                        </a>
                    </div>

                    @if (Model.Orders.Any())
                    {
                        <div class="orders-list">
                            @foreach (var order in Model.Orders)
                            {
                                string statusClass = "status-pending";
                                string statusText = "قيد المعالجة";

                                switch (order.Status?.ToLower())
                                {
                                    case "completed":
                                    case "delivered":
                                        statusClass = "status-approved";
                                        statusText = "تم التوصيل";
                                        break;
                                    case "cancelled":
                                        statusClass = "status-rejected";
                                        statusText = "طلب ملغي";
                                        break;
                                    case "shipped":
                                        statusClass = "status-pending";
                                        statusText = "في الطريق إليك";
                                        break;
                                    default:
                                        statusClass = "status-waiting";
                                        statusText = "بانتظار التأكيد";
                                        break;
                                }

                                <div class="order-card mb-3">
                                    <div class="order-card-header">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="order-id-badge">تفاصيل الطلب</span>
                                            <span class="status-pill @statusClass">@statusText</span>
                                        </div>
                                        <span class="order-date">@order.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    </div>

                                    <div class="order-card-body p-3">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            var p = item.Product;
                                            var itemImg = p?.ProductImages?.FirstOrDefault(i => i.IsMain)?.ImageUrl
                                                          ?? p?.ProductImages?.FirstOrDefault()?.ImageUrl
                                                          ?? "/images/placeholder.jpg";

                                            <div class="order-item-mini py-2">
                                                <img src="@itemImg" alt="@p?.Name" class="order-item-img" style="width: 50px; height: 50px;" />
                                                <div class="flex-grow-1">
                                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="order-item-name">
                                                        @p?.Name
                                                    </a>
                                                    <small class="text-muted d-block">السعر: @item.PriceAtPurchase.ToString("N0") د.أ</small>
                                                </div>
                                            </div>
                                        }

                                        <div class="pt-2 border-top mt-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <small class="text-muted">العنوان: @order.ShippingAddress</small>
                                            <div class="d-flex align-items-center gap-3">
                                                <strong style="color: var(--maroon);">الإجمالي: @order.TotalPrice.ToString("N0") د.أ</strong>
                                                
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="heritage-empty-card py-5">
                            <div class="heritage-empty-icon">
                                <i class="bi bi-bag-x"></i>
                            </div>
                            <h4>لا توجد طلبات شراء سابقة</h4>
                            <p class="text-muted">لم تقم بإجراء أي طلب بعد. تصفح أحدث القطع التراثية المتوفرة للشراء.</p>
                            <a asp-controller="Explore" asp-action="Index" class="btn btn-heritage">
                                <i class="bi bi-compass me-1"></i> تصفح القطع المتاحة
                            </a>
                        </div>
                    }
                </div>
            </div>

            @* ==================== TAB 4: معاينة ملفي العام ==================== *@
            <div id="tab-preview" class="profile-tab-pane">
                <div class="modern-profile-card mb-4">
                    <div class="profile-card-header">
                        <h2>معاينة ملفك العام </h2>
                        <a asp-controller="Profile" asp-action="UserProfile" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-heritage btn-sm">
                            <i class="bi bi-box-arrow-up-right me-1"></i> فتح الرابط المباشر
                        </a>
                    </div>

                    @* بطاقة المعاينة *@
                    <div class="public-profile-header mb-4">
                        <div class="row align-items-center g-4">
                            <div class="col-auto">
                                @if (!string.IsNullOrEmpty(Model.ProfileImage))
                                {
                                    <img src="@Model.ProfileImage" alt="@Model.UserName" class="public-profile-avatar" id="previewAvatar" />
                                }
                                else
                                {
                                    <div class="public-profile-avatar d-flex align-items-center justify-content-center" id="previewPlaceholder">
                                        <i class="bi bi-person fs-1" style="color: var(--gold);"></i>
                                    </div>
                                }
                            </div>
                            <div class="col">
                                <div class="d-flex align-items-center gap-3 flex-wrap mb-2">
                                    <h3 class="public-profile-name mb-0" id="previewUserName">@Model.UserName</h3>
                                    
                                    <span class="member-badge">
                                        <i class="bi bi-calendar3"></i>
                                        انضم في @Model.CreatedAt.ToString("dd/MM/yyyy")
                                    </span>
                                </div>

                                <p class="public-profile-bio mb-3" id="previewBio">
                                    @(string.IsNullOrWhiteSpace(Model.Bio) ? "مستخدم ومشارك في توثيق وحفظ التراث الأردني والفلسطيني على منصة حِكاية." : Model.Bio)
                                </p>

                                <div class="d-flex gap-2 flex-wrap">
                                    <span class="badge bg-light text-dark border p-2">
                                        <i class="bi bi-box-seam me-1 text-primary"></i> @approvedProducts.Count قطعة معروضة
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* قطع المستخدم المعروضة للعامة *@
                    <h5 class="mb-3">القطع المعروضة في ملفك العام (@approvedProducts.Count)</h5>
                    @if (approvedProducts.Any())
                    {
                        <div class="row g-3">
                            @foreach (var product in approvedProducts)
                            {
                                var mainImage = product.ProductImages.FirstOrDefault(i => i.IsMain) ?? product.ProductImages.FirstOrDefault();
                                <div class="col-md-4 col-6" id="previewProduct_@product.ProductId">
                                    <div class="product-card">
                                        <div class="product-card-media">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId">
                                                <img src="@(mainImage != null ? mainImage.ImageUrl : "/images/placeholder.jpg")" alt="@product.Name" loading="lazy" />
                                            </a>
                                        </div>
                                        <div class="product-card-body">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId" class="product-title-link">
                                                <h6 class="product-title mb-1">@product.Name</h6>
                                            </a>
                                            <div class="product-card-footer mt-2">
                                                @if (product.ListingType == "for_sale" && product.Price.HasValue)
                                                {
                                                    <div class="price-tag">
                                                        @product.Price.Value.ToString("N0") <small class="currency">د.أ</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="badge-archive">قطعة للعرض</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small">لا توجد قطع معتمدة معروضة في ملفك العام حتى الآن.</p>
                    }
                </div>
            </div>

        </div>
    </div>

    @* نافذة تأكيد حذف القطعة التراثية *@
    <div class="modal fade" id="deleteProductModal" tabindex="-1" aria-labelledby="deleteProductModalLabel" aria-hidden="true" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 18px; border: 1px solid var(--border); box-shadow: 0 16px 40px rgba(43,36,32,0.12);">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="deleteProductModalLabel" style="color: var(--maroon);">
                        <i class="bi bi-exclamation-triangle-fill  fs-5"></i>
                        <span>تأكيد حذف القطعة</span>
                    </h5>
                    <button type="button" class="btn-close ms-0 me-auto text-end" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="mb-2 text-muted">هل أنت متأكد من رغبتك في حذف هذه القطعة التراثية من حسابك؟</p>
                    <div class="p-3 rounded-3 border fw-bold text-truncate" id="deleteModalProductName" style="background: var(--bg); color: var(--ink);">
                        اسم القطعة
                    </div>
                    <small class="text-muted d-block mt-2">
                        <i class="bi bi-info-circle me-1"></i> لن تظهر القطعة في متجرك أو في ملفك العام بعد الحذف.
                    </small>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">إلغاء</button>
                    <button type="button" class="btn btn-outline-heritage px-4" id="btnConfirmDeleteProduct">
                        <i class="bi bi-trash3-fill me-1"></i> نعم، احذف القطعة
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* فورم تسجيل الخروج *@
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" id="logoutForm" class="d-none"></form>
    <form id="antiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // ===== 1. التبديل السلس بين التبويبات دون الانتقال لصفحة جديدة =====
            const tabButtons = document.querySelectorAll('.profile-nav-btn[data-tab-target]');
            const tabPanes = document.querySelectorAll('.profile-tab-pane');

            tabButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const targetId = this.dataset.tabTarget;
                    const targetPane = document.getElementById(targetId);

                    if (!targetPane) return;

                    tabButtons.forEach(b => b.classList.remove('active'));
                    tabPanes.forEach(p => p.classList.remove('active'));

                    this.classList.add('active');
                    targetPane.classList.add('active');
                });
            });

            // ===== 2. تفعيل وإلغاء وضع تعديل البيانات الشخصية مع إتاحة تعديل اسم المستخدم =====
            const btnToggleEdit = document.getElementById('btnToggleEdit');
            const btnCancelEdit = document.getElementById('btnCancelEdit');
            const editBtnText = document.getElementById('editBtnText');
            const editBtnIcon = document.getElementById('editBtnIcon');
            const editActionButtons = document.getElementById('editActionButtons');

            const inputUserName = document.getElementById('inputUserName');
            const inputPhone = document.getElementById('inputPhoneNumber');
            const inputBio = document.getElementById('inputBio');

            let isEditing = false;
            let originalUserName = inputUserName ? inputUserName.value : '';
            let originalPhone = inputPhone ? inputPhone.value : '';
            let originalBio = inputBio ? inputBio.value : '';

            function setEditMode(enable) {
                isEditing = enable;

                const fields = [inputUserName, inputPhone, inputBio];

                if (enable) {
                    fields.forEach(f => {
                        if (f) {
                            f.removeAttribute('readonly');
                            f.classList.remove('is-readonly');
                            f.classList.add('is-editing');
                        }
                    });

                    editActionButtons.classList.remove('d-none');
                    editBtnText.textContent = 'إلغاء التعديل';
                    editBtnIcon.className = 'bi bi-x-lg';
                    if (inputUserName) inputUserName.focus();
                } else {
                    fields.forEach(f => {
                        if (f) {
                            f.setAttribute('readonly', 'true');
                            f.classList.remove('is-editing');
                            f.classList.add('is-readonly');
                        }
                    });

                    if (inputUserName) inputUserName.value = originalUserName;
                    if (inputPhone) inputPhone.value = originalPhone;
                    if (inputBio) inputBio.value = originalBio;

                    editActionButtons.classList.add('d-none');
                    editBtnText.textContent = 'تعديل البيانات';
                    editBtnIcon.className = 'bi bi-pencil-square';
                }
            }

            if (btnToggleEdit) {
                btnToggleEdit.addEventListener('click', function () {
                    setEditMode(!isEditing);
                });
            }

            if (btnCancelEdit) {
                btnCancelEdit.addEventListener('click', function () {
                    setEditMode(false);
                });
            }

            // ===== 3. رفع وتحديث الصورة الشخصية فورياً دون الحاجة للضغط على حفظ =====
            const instantAvatarInput = document.getElementById('instantAvatarInput');
            const avatarPreview = document.getElementById('avatarPreview');
            const avatarPlaceholderBox = document.getElementById('avatarPlaceholderBox');
            const previewAvatar = document.getElementById('previewAvatar');

            if (instantAvatarInput) {
                instantAvatarInput.addEventListener('change', async function () {
                    const file = this.files[0];
                    if (!file) return;

                    // إظهار معاينة فورية محلياً
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        if (avatarPreview) {
                            avatarPreview.src = e.target.result;
                            avatarPreview.classList.remove('d-none');
                        }
                        if (avatarPlaceholderBox) avatarPlaceholderBox.classList.add('d-none');
                        if (previewAvatar) previewAvatar.src = e.target.result;
                    };
                    reader.readAsDataURL(file);

                    // إرسال الصورة للسيرفر فورياً عبر AJAX وحفظها بقاعدة البيانات
                    const formData = new FormData();
                    formData.append('avatar', file);

                    try {
                        const response = await fetch('/Profile/UpdateAvatar', {
                            method: 'POST',
                            body: formData
                        });
                        const result = await response.json();

                        if (result.success) {
                            showToast(result.message || 'تم تحديث الصورة الشخصية وحفظها بنجاح! ✓', 'success');
                            if (result.imageUrl) {
                                if (avatarPreview) avatarPreview.src = result.imageUrl;
                                if (previewAvatar) previewAvatar.src = result.imageUrl;
                            }
                        } else {
                            showToast(result.message || 'تعذر رفع الصورة.', 'error');
                        }
                    } catch (err) {
                        console.error('Avatar upload failed:', err);
                        showToast('حدث خطأ أثناء حفظ الصورة الشخصية.', 'error');
                    }
                });
            }

            // توست تنبيه سريع
            function showToast(message, type = 'success') {
                const toast = document.createElement('div');
                toast.style.position = 'fixed';
                toast.style.bottom = '24px';
                toast.style.left = '24px';
                toast.style.zIndex = '9999';
                toast.style.backgroundColor = type === 'success' ? 'var(--green)' : 'var(--maroon)';
                toast.style.color = '#FFFFFF';
                toast.style.padding = '12px 20px';
                toast.style.borderRadius = '10px';
                toast.style.boxShadow = '0 6px 20px rgba(0,0,0,0.2)';
                toast.style.fontSize = '0.92rem';
                toast.style.direction = 'rtl';
                toast.style.display = 'flex';
                toast.style.alignItems = 'center';
                toast.style.gap = '8px';
                toast.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i> <span>${message}</span>`;
                document.body.appendChild(toast);

                setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transition = 'opacity 0.3s';
                    setTimeout(() => toast.remove(), 300);
                }, 3000);
            }

            // ===== 4. حذف القطعة التراثية بنظام الحذف الناعم (IsDeleted = true) =====
            let targetProductIdToDelete = null;
            const deleteProductModalEl = document.getElementById('deleteProductModal');
            const deleteModalProductName = document.getElementById('deleteModalProductName');
            const btnConfirmDeleteProduct = document.getElementById('btnConfirmDeleteProduct');
            const productsBadgeCounter = document.getElementById('sidebarProductsBadge');
            const productsCountHeader = document.getElementById('productsCountHeader');
            const userProductsEmptyState = document.getElementById('userProductsEmptyState');
            const userProductsList = document.getElementById('userProductsList');

            // عند الضغط على زر حذف في بطاقة أي قطعة
            document.addEventListener('click', function (e) {
                const deleteBtn = e.target.closest('.btn-delete-product');
                if (!deleteBtn) return;

                targetProductIdToDelete = deleteBtn.dataset.productId;
                const productName = deleteBtn.dataset.productName || 'القطعة التراثية';

                if (deleteModalProductName) {
                    deleteModalProductName.textContent = productName;
                }

                if (deleteProductModalEl && typeof bootstrap !== 'undefined') {
                    const modal = bootstrap.Modal.getOrCreateInstance(deleteProductModalEl);
                    modal.show();
                }
            });

            // عند تأكيد الحذف من النافذة المنبثقة
            if (btnConfirmDeleteProduct) {
                btnConfirmDeleteProduct.addEventListener('click', async function () {
                    if (!targetProductIdToDelete) return;

                    const originalBtnHtml = btnConfirmDeleteProduct.innerHTML;
                    btnConfirmDeleteProduct.disabled = true;
                    btnConfirmDeleteProduct.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> جاري الحذف...';

                    try {
                        const tokenEl = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]') ||
                                        document.querySelector('input[name="__RequestVerificationToken"]');
                        const token = tokenEl ? tokenEl.value : '';

                        const formData = new FormData();
                        formData.append('id', targetProductIdToDelete);
                        if (token) {
                            formData.append('__RequestVerificationToken', token);
                        }

                        const response = await fetch('/Profile/DeleteProduct', {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Accept': 'application/json'
                            },
                            body: formData
                        });

                        const result = await response.json();

                        if (result.success) {
                            // إغلاق النافذة المنبثقة
                            if (deleteProductModalEl && typeof bootstrap !== 'undefined') {
                                const modal = bootstrap.Modal.getInstance(deleteProductModalEl) || bootstrap.Modal.getOrCreateInstance(deleteProductModalEl);
                                modal.hide();
                            }

                            // إخفاء وحذف البطاقة من قائمة "منتجاتي" بانسيابية
                            const cardId = targetProductIdToDelete;
                            const productCard = document.getElementById('productCard_' + cardId);
                            if (productCard) {
                                productCard.style.transition = 'all 0.4s ease';
                                productCard.style.opacity = '0';
                                productCard.style.transform = 'scale(0.9)';
                                setTimeout(() => {
                                    productCard.remove();

                                    // التحقق مما إذا فرغت القائمة
                                    const remainingCards = userProductsList ? userProductsList.querySelectorAll('[id^="productCard_"]').length : 0;
                                    if (remainingCards === 0) {
                                        if (userProductsList) userProductsList.classList.add('d-none');
                                        if (userProductsEmptyState) userProductsEmptyState.classList.remove('d-none');
                                    }
                                }, 400);
                            }

                            // إزالة القطعة من بطاقات معاينة الملف العام إن وجدت
                            const previewCard = document.getElementById('previewProduct_' + cardId);
                            if (previewCard) {
                                previewCard.remove();
                            }

                            // تحديث عدادات القطع
                            if (typeof result.remainingCount !== 'undefined') {
                                if (productsBadgeCounter) productsBadgeCounter.textContent = result.remainingCount;
                                if (productsCountHeader) productsCountHeader.textContent = `منتجاتك التراثية (${result.remainingCount})`;
                            }

                            showToast(result.message || 'تم حذف القطعة بنجاح! ✓', 'success');
                        } else {
                            showToast(result.message || 'تعذر حذف القطعة التراثية.', 'error');
                        }
                    } catch (err) {
                        console.error('Error deleting product:', err);
                        showToast('حدث خطأ في الاتصال أثناء تنفيذ الحذف.', 'error');
                    } finally {
                        btnConfirmDeleteProduct.disabled = false;
                        btnConfirmDeleteProduct.innerHTML = originalBtnHtml;
                        targetProductIdToDelete = null;
                    }
                });
            }
        });
    </script>
}
