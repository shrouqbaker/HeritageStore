@{
    ViewData["Title"] = "من نحن";
}
@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}

<!-- ===== Hero ===== -->
<section class="about-hero">
    <div class="container">
        <h1>لماذا "حِكاية"؟</h1>
        <p>
            وُلدت الفكرة من إيمان بسيط: كل ثوب مطرز يحمل جزءًا من هوية أهله، ومع كل جيل يمر بدون توثيق،
            يضيع جزء من هذه الحكاية. "حِكاية" مساحة رقمية لحفظ هذا الإرث ونقله للأجيال القادمة.
        </p>
    </div>
</section>

<!-- ===== أهمية الحفاظ على التراث ===== -->
<section class="about-block">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h2>أرث لا يُقدَّر بثمن</h2>
                <p>
                    الأثواب الفلسطينية والأردنية ليست مجرد ملابس تقليدية، بل هي سجل حي لتاريخ كل منطقة،
                    تحمل تفاصيل عن العادات والمناسبات والهوية الاجتماعية لأهلها. مع مرور الوقت وتغيّر أنماط الحياة،
                    أصبحت هذه القطع أكثر عرضة للاندثار أو الضياع دون توثيق حقيقي لقصصها ومعانيها.
                </p>
                <p>
                    من هنا جاءت "حِكاية"، لتكون مرجعًا رقميًا يحفظ هذه القطع، ويربط كل ثوب بمكانه وزمانه وحكايته الأصلية.
                </p>
            </div>
            <div class="col-lg-6">
                <img src="~/images\about-heritage.png" class="img-fluid " alt="ثوب تراثي" />
            </div>
        </div>
    </div>
</section>

<!-- ===== أهمية توثيق التطريز ===== -->
<section class="about-block">
    <div class="container">
        <div class="text-center mb-5">
            <h2>لغة الغرزة والخيط</h2>
            <p class="col-lg-7 mx-auto">التطريز ليس زخرفة فقط، بل لغة بصرية لها رموزها ودلالاتها الخاصة بكل منطقة.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="value-card">
                    
                    <div class="icon"><img class="img-fluid rounded" src="~/images\save.png" /></div>
                    <h5>حفظ الرموز</h5>
                    <p>كل نقشة تطريز (كالسرو أو زهرة البرتقال) تحمل معنى ثقافيًا أو اجتماعيًا يستحق أن يُوثّق قبل أن يُنسى.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card">
                    <div class="icon"><img class="img-fluid rounded" src="~/images\places2.png" /></div>
                    <h5>ربط الهوية بالمكان</h5>
                    <p>أسلوب التطريز يختلف من منطقة لأخرى، فتوثيقه يحفظ خصوصية كل مدينة وقريتها الثقافية.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card">
                    <div class="icon"><img class="img-fluid rounded" src="~/images\know2.png" /></div>
                    <h5>نقل المعرفة</h5>
                    <p>توثيق التطريز رقميًا يجعل هذه المعرفة متاحة للأجيال القادمة والباحثين المهتمين بالتراث.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== دور المنصة ===== -->
<section class="about-block">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 order-lg-2">
                <h2>أكثر من مجرد توثيق</h2>
                <p>
                    "حِكاية" مساحة تجمع بين التوثيق والمجتمع؛ فكل قطعة مرفوعة على المنصة تصبح جزءًا من مرجع رقمي
                    يحفظ قصتها وخلفيتها التاريخية ومعنى تطريزها، بحيث يستطيع أي زائر أن يتعرف على تراث منطقة كاملة
                    من خلال قطعة واحدة.
                </p>
            </div>
            <div class="col-lg-6 order-lg-1">
                <img src="~/images\about-archive.png" class="img-fluid rounded" alt="توثيق التراث" />
            </div>
        </div>
    </div>
</section>

<!-- ===== كيف يساهم المجتمع ===== -->
<section class="about-block">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5">
                <h2>كيف تساهم؟</h2>
                <p class="mb-0">توثيق التراث مسؤولية مجتمعية، وأنت جزء منها.</p>
            </div>
            <div class="col-lg-7">
                <div class="contribute-step">
                    <div class="step-num">١</div>
                    <div>
                        <h5>شارك قطعتك</h5>
                        <p>ارفع صورة القطعة التراثية اللي عندك مع تفاصيلها وقصتها، سواء كانت للبيع أو للأرشفة فقط.</p>
                    </div>
                </div>
                <div class="contribute-step">
                    <div class="step-num">٢</div>
                    <div>
                        <h5>وثّق الحكاية</h5>
                        <p>اكتب قصة القطعة وخلفيتها التاريخية ومعنى تطريزها، حتى تصل المعلومة كاملة لمن يشاهدها.</p>
                    </div>
                </div>
                <div class="contribute-step">
                    <div class="step-num">٣</div>
                    <div>
                        <h5>استكشف وشارك</h5>
                        <p>تصفح قطع الآخرين، احفظها بالمفضلة، وشاركها مع من يهتم بالتراث والحفاظ عليه.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

