<!-- ===== استكشف المجموعات ===== -->
@if (Model.Categories.Any())
{
    <section class="container section-block">
        <h2 class="text-center my-4">استكشف المجموعات</h2>
        <div class="row g-3">
            @{
                var firstCategory = Model.Categories.FirstOrDefault();
                var restCategories = Model.Categories.Skip(1).ToList();
            }
            @if (firstCategory != null)
            {
                <div class="col-lg-6">
                    <a asp-controller="Explore" asp-action="Index" asp-route-categoryId="@firstCategory.CategoryId"
                       class="category-tile category-tile-large"
                       style="background-image:url('@(firstCategory.ImageUrl ?? "/images/placeholder.jpg")')">
                        <span>@firstCategory.Name</span>
                    </a>
                </div>
            }
            <div class="col-lg-6">
                <div class="row g-3 h-100">
                    @foreach (var category in restCategories)
                    {
                        <div class="col-6">
                            <a asp-controller="Explore" asp-action="Index" asp-route-categoryId="@category.CategoryId"
                               class="category-tile"
                               style="background-image:url('@(category.ImageUrl ?? "/images/placeholder.jpg")')">
                                <span>@category.Name</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}


<!-- ===== أحدث الإضافات ===== -->
@if (Model.LatestProducts.Any())
{
    <section class="container section-block">
        <div class="text-center my-4">
            <h2>أحدث الإضافات</h2>
        </div>
        <div class="row g-4">
            @foreach (var product in Model.LatestProducts)
            {
                var mainImage = product.ProductImages.FirstOrDefault(i => i.IsMain) ?? product.ProductImages.FirstOrDefault();
                <div class="col-md-3 col-6">
                    <div class="product-card">
                        <div class="product-card-media">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId">
                                <img src="@(mainImage != null ? mainImage.ImageUrl : "/images/placeholder.jpg")" alt="@product.Name" loading="lazy" />
                            </a>
                            <button type="button" class="favorite-btn" data-product-id="@product.ProductId" title="أضف إلى المفضلة">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>
                        <div class="product-card-body">
                            @if (product.EmbroideryType != null)
                            {
                                <span class="embroidery-type-label">تطريز @product.EmbroideryType.Name</span>
                            }
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId" class="product-title-link">
                                <h5 class="product-title">@product.Name</h5>
                            </a>
                            <div class="product-card-footer">
                                @if (product.ListingType == "for_sale" && product.Price.HasValue)
                                {
                                    <div class="price-tag">
                                        @product.Price.Value.ToString("N0") <small class="currency">د.أ</small>
                                    </div>
                                    @if (product.Status == "approved")
                                    {
                                        <button type="button" class="cart-btn" data-product-id="@product.ProductId" title="أضف إلى السلة">
                                            <i class="bi bi-bag-plus"></i>
                                            <span>إضافة اى السلة</span>
                                        </button>
                                    }
                                    else if (product.Status == "sold")
                                    {
                                        <button type="button" class="cart-btn sold" disabled>
                                            تم بيع القطعة
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="badge-archive">قطعة للعرض</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-end my-4">
            <a asp-controller="Explore" asp-action="Index" class="btn-see-all">عرض الكل ←</a>
        </div>
    </section>
}



<!-- ===== دعوة أخيرة ===== -->
<section class="cta-section text-center">
    <div class="container">
        <h2 class="mb-3">كل حكاية جزء من هويتنا</h2>
        <div class="lead-text">
            شارك قطعك التراثية مع مجتمع يهتم بالأصالة.
        </div>
        <div class="lead-text mb-4">
            وثّق حكاية قطعتك، أضف تفاصيلها، وشاركها مع الآخرين أو اعرضها للبيع بسهولة.
        </div>
        <a asp-controller="Product" asp-action="Add" class="btn btn-heritage">أضف قطعتك الآن</a>
    </div>
</section>

<!-- ===== الإحصائيات ===== -->
<section class="stats-section">
    <div class="container">
        <div class="stats-bar">

            <div class="stat-item">
                <div class="stat-icon">
                    <i class="bi bi-bag-heart"></i>
                </div>

                <div class="stat-content">
                    <strong>@(Model.ForSaleProducts)+</strong>
                    <span>قطعة معروضة للبيع</span>
                </div>
            </div>

            <div class="stat-item">
                <div class="stat-icon">
                    <i class="bi bi-archive"></i>
                </div>

                <div class="stat-content">
                    <strong>@(Model.ArchivedProducts)+</strong>
                    <span>قطعة موثقة للعرض</span>
                </div>
            </div>

            <div class="stat-item">
                <div class="stat-icon">
                    <i class="bi bi-tags"></i>
                </div>

                <div class="stat-content">
                    <strong>@(Model.TotalCategories)+</strong>
                    <span>تصنيف تراثي</span>
                </div>
            </div>

            <div class="stat-item">
                <div class="stat-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div class="stat-content">
                    <strong>@(Model.TotalUsers)+</strong>
                    <span>مستخدم</span>
                </div>
            </div>

        </div>
    </div>
</section>
