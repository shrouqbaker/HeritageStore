@model HeritageStore.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "الرئيسية";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}
<!-- ===== Hero ===== -->
<section class="hero-section">
    <div class="hero-overlay"></div>

    <img src="~/images/herosection4.png" class="hero-img" alt="ثوب فلسطيني مطرز" />
    <div class="hero-content">
        <h1>من تراثنا... تبدأ الحِكاية</h1>
        <p>
            في كل غرزة تطريز حكاية تُروى، وفي كل ثوب هويةٌ تُحفظ.
            اكتشف تراثنا الأردني والفلسطيني، وكن جزءًا من حكايته.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a asp-controller="Explore" asp-action="Index" class="btn btn-heritage">استكشف التراث</a>
            <a asp-controller="Product" asp-action="Add" class="btn btn-outline-heritage" style="border-color:#fff; color:#fff;">أضف قطعتك</a>
        </div>
    </div>
</section>


<!-- ===== أهمية التراث + فيديو ===== -->
<section class="container section-block">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <h2 class="mb-3">لماذا نوثّق التراث؟</h2>
            <p class="lead-text">
                كل نقشة تطريز تحمل رمزًا ودلالة، وكل ثوب يعكس هوية منطقة بأكملها. مع مرور الوقت،
                تندثر الكثير من هذه الحكايات إن لم تُحفظ وتُنقل للأجيال القادمة رقميًا.
            </p>
            <a asp-controller="Home" asp-action="About" class="btn btn-outline-heritage mt-2">اعرف المزيد</a>
        </div>
        <div class="col-lg-6">
            <div class="ratio ratio-16x9">
                <iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="التراث الفلسطيني والأردني" allowfullscreen></iframe>
            </div>
        </div>
    </div>
</section>

