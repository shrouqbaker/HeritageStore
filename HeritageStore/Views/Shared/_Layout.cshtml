@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - حِكاية</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
 
    <script>
        window.isAuthenticated = @(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false");
    </script>

    @{
        string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

        Func<string, string, string> navActive = (controller, action) =>
            currentController.Equals(controller, StringComparison.OrdinalIgnoreCase)
            && currentAction.Equals(action, StringComparison.OrdinalIgnoreCase)
                ? "active"
                : "";

        ApplicationUser? currentUser = null;
        if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            currentUser = await UserManager.GetUserAsync(User);
        }
    }

    <header>
        <nav class="navbar navbar-expand-lg site-navbar">
            <div class="container">
                <a class="navbar-brand me-0" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logoheritage.png" alt="شعار حكاية" class="navbar-logo" />
                </a>

                <!-- أيقونات السلة/المفضلة تظهر بجانب الزر على الموبايل -->
                <div class="d-flex align-items-center order-lg-2 ms-auto ms-lg-0">
                    <div class="d-flex align-items-center gap-3 nav-icons nav-icons-mobile d-lg-none">
                        <a class="nav-icon" asp-controller="Favorite" asp-action="Index" title="المفضلة">
                            <i class="bi bi-heart"></i>
                        </a>
                        <a class="nav-icon cart-icon-wrapper" asp-controller="Cart" asp-action="Index" title="السلة">
                            <i class="bi bi-cart3"></i>
                            @await Component.InvokeAsync("CartCount")
                        </a>
                    </div>

                    <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="فتح القائمة">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @navActive("Home", "Index")" asp-controller="Home" asp-action="Index">الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @navActive("Explore", "Index")" asp-controller="Explore" asp-action="Index">استكشف التراث</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @navActive("Home", "About")" asp-controller="Home" asp-action="About">من نحن</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3 nav-icons">
                        <!-- أيقونات شاشات كبيرة فقط -->
                        <a class="nav-icon d-none d-lg-inline-flex" asp-controller="Favorite" asp-action="Index" title="المفضلة">
                            <i class="bi bi-heart"></i>
                        </a>
                        <a class="nav-icon cart-icon-wrapper d-none d-lg-inline-flex" asp-controller="Cart" asp-action="Index" title="السلة">
                            <i class="bi bi-cart3"></i>
                            @await Component.InvokeAsync("CartCount")
                        </a>

                        <!-- البروفايل والقائمة المنسدلة (Desktop) -->
                        <div class="dropdown d-none d-lg-block">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <button class="nav-user-pill dropdown-toggle-no-arrow" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="حسابي">
                                    <span class="nav-user-avatar-wrap">
                                        @if (!string.IsNullOrEmpty(currentUser?.ProfileImage))
                                        {
                                            <img src="@currentUser.ProfileImage" alt="@(currentUser.UserName)" class="nav-user-avatar" />
                                        }
                                        else
                                        {
                                            <span class="nav-user-avatar-default">
                                                <i class="bi bi-person-fill"></i>
                                            </span>
                                        }
                                    </span>
                                    <span class="nav-user-name text-truncate">@(currentUser?.UserName ?? User.Identity.Name)</span>
                                    <i class="bi bi-chevron-down nav-user-chevron"></i>
                                </button>

                                <div class="dropdown-menu dropdown-menu-end modern-user-dropdown animate-dropdown">
                                    <div class="dropdown-user-header">
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(currentUser?.ProfileImage))
                                            {
                                                <img src="@currentUser.ProfileImage" alt="@(currentUser.UserName)" class="dropdown-header-avatar" />
                                            }
                                            else
                                            {
                                                <div class="dropdown-header-placeholder">
                                                    <i class="bi bi-person-fill"></i>
                                                </div>
                                            }
                                            <div class="dropdown-header-info min-w-0">
                                                <div class="dropdown-header-name text-truncate">@(currentUser?.UserName ?? User.Identity.Name)</div>
                                                <div class="dropdown-header-email text-truncate">@(currentUser?.Email ?? "")</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="dropdown-items-group">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a class="dropdown-item user-dropdown-link mb-1" asp-controller="Admin" asp-action="Index" style="background: rgba(122, 31, 43, 0.08); border-radius: 8px;">
                                                <span class="dropdown-link-icon" style="background: var(--maroon); color: #FFFFFF;"><i class="bi bi-speedometer2"></i></span>
                                                <span class="dropdown-link-text">
                                                    <strong style="color: var(--maroon);">لوحة التحكم (الإدارة)</strong>
                                                    <small>إدارة المنتجات والطلبات</small>
                                                </span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="dropdown-item user-dropdown-link" asp-controller="Profile" asp-action="Index">
                                                <span class="dropdown-link-icon"><i class="bi bi-person-gear"></i></span>
                                                <span class="dropdown-link-text">
                                                    <strong>صفحتي الشخصية</strong>
                                                    <small>إدارة بياناتك وحسابك</small>
                                                </span>
                                            </a>
                                        }
                                    </div>

                                    <div class="dropdown-divider my-2"></div>

                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" class="m-0 p-0">
                                        <button type="submit" class="dropdown-item user-dropdown-link logout-link w-100 border-0 bg-transparent text-start">
                                            <span class="dropdown-link-icon"><i class="bi bi-box-arrow-right"></i></span>
                                            <span class="dropdown-link-text">
                                                <strong>تسجيل الخروج</strong>
                                            </span>
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <button class="nav-user-pill dropdown-toggle-no-arrow" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="حسابك">
                                   
                                    <span class="nav-user-name">تسجيل الدخول</span>
                                    <i class="bi bi-chevron-down nav-user-chevron"></i>
                                </button>

                                <div class="dropdown-menu dropdown-menu-end modern-user-dropdown animate-dropdown p-3">
                                    <div class="text-center py-2 mb-2">
                                        <small class="text-muted">أهلاً بك في حِكاية</small>
                                    </div>
                                    <a class="btn btn-heritage w-100 mb-2 py-2 text-center" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> تسجيل الدخول
                                    </a>
                                    <a class="btn btn-outline-heritage w-100 py-2 text-center" asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Context.Request.Path">
                                        <i class="bi bi-person-plus me-1"></i> إنشاء حساب جديد
                                    </a>
                                </div>
                            }
                        </div>

                        <!-- البروفايل والقائمة المتجاوبة (Mobile View) -->
                        <div class="w-100 d-lg-none user-links-mobile">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <div class="mobile-user-card mb-3 p-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="mobile-avatar-wrap">
                                            @if (!string.IsNullOrEmpty(currentUser?.ProfileImage))
                                            {
                                                <img src="@currentUser.ProfileImage" alt="@(currentUser.UserName)" class="mobile-avatar" />
                                            }
                                            else
                                            {
                                                <div class="mobile-avatar-default">
                                                    <i class="bi bi-person-fill"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="mobile-user-info min-w-0">
                                            <h6 class="mb-0 text-truncate fw-bold">@(currentUser?.UserName ?? User.Identity.Name)</h6>
                                            <small class="text-muted text-truncate d-block">@(currentUser?.Email ?? "")</small>
                                        </div>
                                    </div>
                                </div>

                                <ul class="navbar-nav w-100">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li class="nav-item mb-2">
                                            <a class="nav-link mobile-nav-item d-flex align-items-center gap-3" asp-controller="Admin" asp-action="Index" style="background: rgba(122, 31, 43, 0.08); border-radius: 10px;">
                                                <span class="mobile-icon-box" style="background: var(--maroon); color: #FFFFFF;"><i class="bi bi-speedometer2"></i></span>
                                                <span style="color: var(--maroon); font-weight: 700;">لوحة تحكم الإدارة</span>
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link mobile-nav-item d-flex align-items-center gap-3" asp-controller="Profile" asp-action="Index">
                                                <span class="mobile-icon-box"><i class="bi bi-person-gear"></i></span>
                                                <span>صفحتي الشخصية</span>
                                            </a>
                                        </li>
                                    }
                                    <li class="nav-item mt-2">
                                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" class="m-0">
                                            <button type="submit" class="nav-link mobile-nav-item mobile-logout-btn w-100 border-0 bg-transparent d-flex align-items-center gap-3 text-start">
                                                <span class="mobile-icon-box logout-icon"><i class="bi bi-box-arrow-right"></i></span>
                                                <span>تسجيل الخروج</span>
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            }
                            else
                            {
                                <div class="mobile-guest-card p-3 mb-2 text-center">
                                    <p class="mb-2 text-muted fs-7">قم بتسجيل الدخول للاستمتاع بجميع تجارب حكاية</p>
                                    <div class="d-grid gap-2">
                                        <a class="btn btn-heritage py-2" asp-area="Identity" asp-page="/Account/Login">
                                            <i class="bi bi-box-arrow-in-right me-1"></i> تسجيل الدخول
                                        </a>
                                        <a class="btn btn-outline-heritage py-2" asp-area="Identity" asp-page="/Account/Register">
                                            <i class="bi bi-person-plus me-1"></i> إنشاء حساب جديد
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3" dir="rtl">
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 12px; background: rgba(47, 74, 60, 0.12); color: var(--green); font-weight: 600;">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3" dir="rtl">
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 12px; background: rgba(122, 31, 43, 0.12); color: var(--maroon); font-weight: 600;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row text-center text-md-start">
                <div class="col-12 col-md-4 mb-4 mb-md-0">
                    <h5>حِكاية</h5>
                    <p>مساحة رقمية لتوثيق وحفظ الأثواب والتطريز التراثي الأردني والفلسطيني.</p>
                </div>
                <div class="col-12 col-md-4 mb-4 mb-md-0">
                    <h5>روابط</h5>
                    <p class="mb-1"><a asp-controller="Home" asp-action="Index">الرئيسية</a></p>
                    <p class="mb-1"><a asp-controller="Explore" asp-action="Index">استكشف التراث</a></p>
                    <p class="mb-0"><a asp-controller="Home" asp-action="About">من نحن</a></p>
                </div>
                <div class="col-12 col-md-4 mb-0">
                    <h5>تواصل معنا</h5>
                    <p class="mb-0">info@heritage.com</p>
                </div>
            </div>
            <hr style="border-color:#4a4038;" />
            <p class="text-center mb-0">© 2026 حِكاية. جميع الحقوق محفوظة.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/guest-storage.js" asp-append-version="true"></script>
    <script src="~/js/product-card-actions.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script>
            (async function mergeGuestDataOnLogin() {
                const guestFavorites = JSON.parse(localStorage.getItem('guestFavorites') || '[]');
                const guestCart = JSON.parse(localStorage.getItem('guestCart') || '[]');

                if (guestFavorites.length > 0) {
                    try {
                        await fetch('/Favorite/MergeGuestFavorites', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(guestFavorites)
                        });
                        localStorage.removeItem('guestFavorites');
                    } catch (e) {
                        console.error('Failed to merge favorites:', e);
                    }
                }

                if (guestCart.length > 0) {
                    try {
                        const response = await fetch('/Cart/MergeGuestCart', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(guestCart)
                        });
                        const resData = await response.json();
                        if (resData && typeof resData.count !== 'undefined') {
                            GuestStorage.updateCartBadge(resData.count);
                        }
                        localStorage.removeItem('guestCart');
                    } catch (e) {
                        console.error('Failed to merge cart:', e);
                    }
                }
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>