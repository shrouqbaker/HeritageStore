<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - حِكاية</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>


<body>
 
    <script>
        window.isAuthenticated = @(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false");
    </script>

    @{
        string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

        Func<string, string, string> navActive = (controller, action) =>
            currentController.Equals(controller, StringComparison.OrdinalIgnoreCase)
            && currentAction.Equals(action, StringComparison.OrdinalIgnoreCase)
                ? "active"
                : "";
    }

    <header>
        <nav class="navbar navbar-expand-lg site-navbar">
            <div class="container">
                <a class="navbar-brand me-0" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logoheritage.png" alt="شعار حكاية" class="navbar-logo" />
                </a>

                <!-- أيقونات السلة/المفضلة تظهر بجانب الزر على الموبايل -->
                <div class="d-flex align-items-center order-lg-2 ms-auto ms-lg-0">
                    <div class="d-flex align-items-center gap-3 nav-icons nav-icons-mobile d-lg-none">
                        <a class="nav-icon" asp-controller="Favorite" asp-action="Index" title="المفضلة">
                            <i class="bi bi-heart"></i>
                        </a>
                        <a class="nav-icon cart-icon-wrapper" asp-controller="Cart" asp-action="Index" title="السلة">
                            <i class="bi bi-cart3"></i>
                            @await Component.InvokeAsync("CartCount")
                        </a>
                    </div>

                    <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="فتح القائمة">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @navActive("Home", "Index")" asp-controller="Home" asp-action="Index">الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @navActive("Explore", "Index")" asp-controller="Explore" asp-action="Index">استكشف التراث</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @navActive("Home", "About")" asp-controller="Home" asp-action="About">من نحن</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3 nav-icons">
                        <!-- شاشات كبيرة فقط -->
                        <a class="nav-icon d-none d-lg-inline-flex" asp-controller="Favorite" asp-action="Index" title="المفضلة">
                            <i class="bi bi-heart"></i>
                        </a>
                        <a class="nav-icon cart-icon-wrapper d-none d-lg-inline-flex" asp-controller="Cart" asp-action="Index" title="السلة">
                            <i class="bi bi-cart3"></i>
                            @await Component.InvokeAsync("CartCount")
                        </a>

                        <div class="dropdown d-none d-lg-block">
                            <a class="nav-icon dropdown-toggle-no-arrow" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">صفحتي الشخصية</a></li>
                                    <li><a class="dropdown-item" asp-controller="Product" asp-action="MyProducts">منتجاتي</a></li>
                                    <li><a class="dropdown-item" asp-controller="Order" asp-action="Index">طلباتي</a></li>
                                    <li><a class="dropdown-item btn-heritage btn btn-sm text-white" asp-controller="Product" asp-action="Add">أضف قطعتك</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                                            <button type="submit" class="dropdown-item">تسجيل الخروج</button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path">تسجيل الدخول</a></li>
                                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Context.Request.Path">إنشاء حساب</a></li>
                                }
                            </ul>
                        </div>

                        <!-- الموبايل فقط -->
                        <ul class="navbar-nav w-100 d-lg-none user-links-mobile">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">صفحتي الشخصية</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="MyProducts">منتجاتي</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Order" asp-action="Index">طلباتي</a></li>
                                <li class="nav-item mt-2">
                                    <a class="btn-heritage btn btn-sm d-inline-block" asp-controller="Product" asp-action="Add">أضف قطعتك</a>
                                </li>
                                <li class="nav-item mt-2">
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" class="m-0">
                                        <button type="submit" class="nav-link btn btn-link p-0 text-start w-100 border-0">تسجيل الخروج</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">تسجيل الدخول</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">إنشاء حساب</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row text-center text-md-start">
                <div class="col-12 col-md-4 mb-4 mb-md-0">
                    <h5>حِكاية</h5>
                    <p>مساحة رقمية لتوثيق وحفظ الأثواب والتطريز التراثي الأردني والفلسطيني.</p>
                </div>
                <div class="col-12 col-md-4 mb-4 mb-md-0">
                    <h5>روابط</h5>
                    <p class="mb-1"><a asp-controller="Home" asp-action="Index">الرئيسية</a></p>
                    <p class="mb-1"><a asp-controller="Explore" asp-action="Index">استكشف التراث</a></p>
                    <p class="mb-0"><a asp-controller="Home" asp-action="About">من نحن</a></p>
                </div>
                <div class="col-12 col-md-4 mb-0">
                    <h5>تواصل معنا</h5>
                    <p class="mb-0">info@heritage.com</p>
                </div>
            </div>
            <hr style="border-color:#4a4038;" />
            <p class="text-center mb-0">© 2026 حِكاية. جميع الحقوق محفوظة.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/guest-storage.js" asp-append-version="true"></script>
    <script src="~/js/product-card-actions.js" asp-append-version="true"></script>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script>
            (async function mergeGuestDataOnLogin() {
                const guestFavorites = JSON.parse(localStorage.getItem('guestFavorites') || '[]');
                const guestCart = JSON.parse(localStorage.getItem('guestCart') || '[]');

                if (guestFavorites.length > 0) {
                    try {
                        await fetch('/Favorite/MergeGuestFavorites', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(guestFavorites)
                        });
                        localStorage.removeItem('guestFavorites');
                    } catch (e) {
                        console.error('Failed to merge favorites:', e);
                    }
                }

                if (guestCart.length > 0) {
                    try {
                        const response = await fetch('/Cart/MergeGuestCart', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(guestCart)
                        });
                        const resData = await response.json();
                        if (resData && typeof resData.count !== 'undefined') {
                            GuestStorage.updateCartBadge(resData.count);
                        }
                        localStorage.removeItem('guestCart');
                    } catch (e) {
                        console.error('Failed to merge cart:', e);
                    }
                }
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>