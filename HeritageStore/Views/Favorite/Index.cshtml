@{
    ViewData["Title"] = "المفضلة";
}

@section Styles {
    <link rel="stylesheet" href="~/css/wishlist.css" asp-append-version="true" />
}

<div class="container wishlist-page py-4 py-lg-5" dir="rtl">

    @* BREADCRUMB *@
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb heritage-breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door-fill me-1"></i> الرئيسية</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">المفضلة</li>
        </ol>
    </nav>

    @* EMPTY STATE *@
    <div id="emptyWishlistState" class="wishlist-empty-card text-center py-5 d-none">
        <div class="empty-icon-wrapper mb-3">
            <i class="bi bi-heart"></i>
        </div>
        <h2 class="empty-title">لا توجد قطع في المفضلة</h2>
        <p class="empty-text mb-4">احفظي القطع التراثية أعجبتك لتعودي الها لاحقا.</p>
        <a asp-controller="Explore" asp-action="Index" class="btn-heritage-primary">
            <i class="bi bi-compass-fill me-2"></i> استكشفي التراث
        </a>
    </div>

    @* يتعبى بالجافاسكربت — مسجّل أو زائر *@
    <div id="wishlistGrid"></div>

</div>

@section Scripts {
    <script src="~/js/wishlist-page.js" asp-append-version="true"></script>
}